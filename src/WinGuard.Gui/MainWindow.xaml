<Window x:Class="WinGuard.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinGuard.Gui.Views"
        Title="{Binding WindowTitle}"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="5" />
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="6" />
        <KeyBinding Key="NumPad1" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="1" />
        <KeyBinding Key="NumPad2" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="2" />
        <KeyBinding Key="NumPad3" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="3" />
        <KeyBinding Key="NumPad4" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="4" />
        <KeyBinding Key="NumPad5" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="5" />
        <KeyBinding Key="NumPad6" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="6" />
    </Window.InputBindings>

    <views:ShellView x:Name="Shell" />
</Window>
