<Window x:Class="WinGuard.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinGuard.Gui.ViewModels"
        xmlns:views="clr-namespace:WinGuard.Gui.Views"
        Title="{Binding WindowTitle}"
        Height="760" Width="1180"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BlockedIpsViewModel}">
            <views:BlockedIpsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventLogViewModel}">
            <views:EventLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ListsViewModel}">
            <views:ListsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,14">
                    <TextBlock Text="WinGuard" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Intrusion prevention" FontSize="11"
                               Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,16">
                    <Border CornerRadius="10" Padding="10,6" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Dashboard.ConnectionText}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                    </Border>
                    <Button Content="{Binding ThemeButtonText}" Command="{Binding CycleThemeCommand}"
                            ToolTip="Switch between following Windows, light and dark" />
                </StackPanel>

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="14" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>