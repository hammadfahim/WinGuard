<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:WinGuard.Gui.Controls"
                    xmlns:conv="clr-namespace:WinGuard.Gui.Converters">

    <!-- The console's whole control vocabulary. Colours arrive only through DynamicResource tokens,
         so a theme swap repaints everything and no view needs to know a colour. Tokens are merged
         here, not beside this file, because StaticResource cannot see sibling dictionaries. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    <conv:NotEmptyToVisibilityConverter x:Key="EmptyToVis" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:NotEmptyToBoolConverter x:Key="NotEmptyToBool" />

    <!-- ===== Focus ===== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="2"
                            CornerRadius="{StaticResource RadiusLg}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text ===== -->
    <Style x:Key="TextDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUiLight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="TextHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="TextStrong" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="TextMuted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="TextOverline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="TextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="TextMetric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUiLight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMetric}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontIcon}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Text that takes its colour from a Tone. -->
    <Style x:Key="ToneIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="ui:Ui.Tone" Value="Protected">
                <Setter Property="Foreground" Value="{DynamicResource ProtectedTextBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Attack">
                <Setter Property="Foreground" Value="{DynamicResource AttackTextBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Warn">
                <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Accent">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToneText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="ui:Ui.Tone" Value="Protected">
                <Setter Property="Foreground" Value="{DynamicResource ProtectedTextBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Attack">
                <Setter Property="Foreground" Value="{DynamicResource AttackTextBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Warn">
                <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Accent">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A small status dot. -->
    <Style x:Key="ToneDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
        <Style.Triggers>
            <Trigger Property="ui:Ui.Tone" Value="Protected">
                <Setter Property="Fill" Value="{DynamicResource ProtectedBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Attack">
                <Setter Property="Fill" Value="{DynamicResource AttackBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Warn">
                <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Accent">
                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A compact label pill. -->
    <Style x:Key="Chip" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusPill}"
                            Padding="8,2" BorderThickness="1" BorderBrush="{DynamicResource ChipBorderBrush}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ui:Ui.Tone" Value="Protected">
                <Setter Property="Background" Value="{DynamicResource ProtectedSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ProtectedTextBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Attack">
                <Setter Property="Background" Value="{DynamicResource AttackSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AttackTextBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A tinted notice: the surface follows a Tone, the border stays quiet. -->
    <Style x:Key="Callout" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="12,8" />
        <Style.Triggers>
            <Trigger Property="ui:Ui.Tone" Value="Protected">
                <Setter Property="Background" Value="{DynamicResource ProtectedSoftBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Attack">
                <Setter Property="Background" Value="{DynamicResource AttackSoftBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hairline" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource LineBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===== Buttons ===== -->
    <ControlTemplate x:Key="ButtonChrome" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMd}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                <TextBlock x:Name="Ico" Style="{StaticResource Icon}" Text="{TemplateBinding ui:Ui.Icon}" Margin="0,0,7,0"
                           FontSize="13" />
                <ContentPresenter x:Name="Cp" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                <Setter TargetName="Ico" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Ico" Property="Margin" Value="0" />
                <Setter TargetName="Cp" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{Binding (ui:Ui.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="Bd" Property="BorderBrush"
                        Value="{Binding (ui:Ui.HoverBorder), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{Binding (ui:Ui.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Default: a quiet outlined button. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="ui:Ui.HoverBorder" Value="{DynamicResource HoverLineBrush}" />
        <Setter Property="ui:Ui.PressedBackground" Value="{DynamicResource SurfacePressedBrush}" />
        <Setter Property="Template" Value="{StaticResource ButtonChrome}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="ui:Ui.HoverBorder" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="ui:Ui.PressedBackground" Value="{DynamicResource AccentPressedBrush}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AttackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAttackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AttackBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="ui:Ui.HoverBackground" Value="{DynamicResource AttackBrush}" />
        <Setter Property="ui:Ui.HoverBorder" Value="{DynamicResource FocusRingBrush}" />
        <Setter Property="ui:Ui.PressedBackground" Value="{DynamicResource AttackBrush}" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="ui:Ui.HoverBorder" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- A square, icon-only ghost button. Always give these an AutomationProperties.Name and a ToolTip. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="IconButtonSmall" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="{StaticResource ControlHeightSmall}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
    </Style>

    <!-- A hover action inside a grid or list row. It carries its own colour, so on a selected row it
         must follow the selection: in high contrast that row is a solid Highlight fill. -->
    <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
        <Setter Property="IsTabStop" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ListRowAction" TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Inline text link. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Label" Background="Transparent">
                        <ContentPresenter RecognizesAccessKey="True" />
                    </TextBlock>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A whole card that acts as a link. -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusLg}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverLineBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width list row that acts as a link (recent blocks, top attackers). -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Toggles ===== -->
    <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Fill="{DynamicResource TextSecondaryBrush}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ContentPresenter x:Name="Cp" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Cp" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource HoverLineBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="17" Duration="{StaticResource MotionFast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="{StaticResource MotionFast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
                            <TextBlock x:Name="Mark" Style="{StaticResource Icon}" Text="{StaticResource GlyphCheck}" FontSize="11"
                                       HorizontalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextOnAccentBrush}" />
                        </Border>
                        <ContentPresenter x:Name="Cp" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Cp" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HoverLineBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip: on = quietly tinted with a tick, off = bare outline. Chips are on by default, so
         the on state must not shout. The tick means the state never rests on colour alone. -->
    <Style x:Key="FilterChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusPill}">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <TextBlock x:Name="Check" Style="{StaticResource Icon}" Text="{StaticResource GlyphCheck}" FontSize="10"
                                       Margin="0,0,6,0" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" />
                            <TextBlock x:Name="Badge" Text="{TemplateBinding ui:Ui.Badge}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Opacity="0.75" FontSize="{StaticResource FontSizeMicro}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Ui.Badge" Value="{x:Null}">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverLineBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A segmented control: RadioButtons inside a SegmentGroup border. -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ===== -->
    <ControlTemplate x:Key="TextBoxChrome" TargetType="TextBox">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMd}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Ico" Style="{StaticResource Icon}" Text="{TemplateBinding ui:Ui.Icon}"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0,0,0" FontSize="12" />
                <TextBlock x:Name="Hint" Grid.Column="1" Text="{TemplateBinding ui:Ui.Placeholder}" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="{TemplateBinding Padding}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" Padding="2,0,0,0" />
                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                <Button x:Name="Clear" Grid.Column="2" Style="{StaticResource IconButtonSmall}" Margin="0,0,3,0"
                        Width="22" Height="22" FontSize="10" IsTabStop="False" Visibility="Collapsed"
                        ui:Ui.Icon="{StaticResource GlyphClose}" Command="{x:Static ui:Ui.ClearText}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        ToolTip="Clear" AutomationProperties.Name="Clear" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                <Setter TargetName="Ico" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Text" Value="" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ui:Ui.Clearable" Value="True" />
                    <Condition Property="ui:Ui.HasText" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Clear" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverLineBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.HasError" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AttackBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource TextBoxChrome}" />
    </Style>

    <!-- A search field: leading magnifier, clear button, Ctrl+F target. -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="ui:Ui.Icon" Value="{StaticResource GlyphSearch}" />
        <Setter Property="ui:Ui.Clearable" Value="True" />
        <Setter Property="ui:Ui.IsPageSearch" Value="True" />
    </Style>

    <Style x:Key="MonoBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMd}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverLineBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: non-editable only. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource RadiusSm}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,0,0,0" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{DynamicResource SurfaceSunkenBrush}"
                                            BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphChevronDown}" FontSize="10"
                                                   HorizontalAlignment="Right" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverLineBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="None">
                            <Border Margin="10,4,10,14" Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="3"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Effect="{DynamicResource ElevationOverlay}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lists ===== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusMd}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A flat row for dense feeds: fixed height, hairline under it. -->
    <Style x:Key="FeedRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="{StaticResource FeedRowHeight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rail navigation row: the selection bar itself is one element that slides between rows. -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusMd}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Grids ===== -->
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    </Style>

    <!-- Text with its own colour stops inheriting, so on a selected row it must switch to the
         selection's text colour itself. In high contrast selection is a solid Highlight fill, and
         a fixed colour on it can be unreadable. -->
    <Style x:Key="CellMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FeedMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FeedTone" TargetType="TextBlock" BasedOn="{StaticResource ToneText}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FeedToneIcon" TargetType="TextBlock" BasedOn="{StaticResource ToneIcon}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="RowHeight" Value="{StaticResource GridRowHeight}" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="False" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="ColumnGripper" TargetType="Thumb">
        <Setter Property="Width" Value="6" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock x:Name="Arrow" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0"
                                           Foreground="{DynamicResource AccentTextBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ColumnGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ColumnGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Arrow" Property="Text" Value="{StaticResource GlyphChevronUp}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Arrow" Property="Text" Value="{StaticResource GlyphChevronDown}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                        <StackPanel>
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="True" />
                            <DataGridDetailsPresenter Visibility="{TemplateBinding DetailsVisibility}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Menus ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="0,0,10,12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMd}"
                            Padding="{TemplateBinding Padding}" Effect="{DynamicResource ElevationOverlay}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6,14,6" />
        <Setter Property="MinWidth" Value="190" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding ui:Ui.Icon}" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="20,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeCaption}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Style="{StaticResource Hairline}" Margin="4,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scroll bars ===== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Margin="3" Background="{DynamicResource ScrollThumbBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Tooltips ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMd}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Progress ===== -->
    <Style x:Key="ShareBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{DynamicResource NeutralSoftBrush}" CornerRadius="2.5" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Status surfaces ===== -->
    <!-- The 3 px spine across the top of the window: the console's one constant status signal. -->
    <Style x:Key="ToneFill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
        <Style.Triggers>
            <Trigger Property="ui:Ui.Tone" Value="Protected">
                <Setter Property="Background" Value="{DynamicResource ProtectedBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Attack">
                <Setter Property="Background" Value="{DynamicResource AttackBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The state banner: quiet while protected, tinted the moment anything needs a look. -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RailBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="28,5,16,5" />
        <Style.Triggers>
            <Trigger Property="ui:Ui.Tone" Value="Attack">
                <Setter Property="Background" Value="{DynamicResource AttackSoftBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The one banner that is not a tint: nothing is enforced, and that must not read as a notice. -->
    <Style x:Key="BannerCritical" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AttackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AttackBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="28,9,16,10" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAttackBrush}" />
    </Style>

    <!-- The brand shield, coloured by state. -->
    <Style x:Key="ToneShield" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource ShieldGeometry}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Fill" Value="{DynamicResource NeutralSoftBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
        <Style.Triggers>
            <Trigger Property="ui:Ui.Tone" Value="Protected">
                <Setter Property="Fill" Value="{DynamicResource ProtectedSoftBrush}" />
                <Setter Property="Stroke" Value="{DynamicResource ProtectedBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Attack">
                <Setter Property="Fill" Value="{DynamicResource AttackSoftBrush}" />
                <Setter Property="Stroke" Value="{DynamicResource AttackBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Tone" Value="Warn">
                <Setter Property="Fill" Value="{DynamicResource WarnSoftBrush}" />
                <Setter Property="Stroke" Value="{DynamicResource WarnBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A chart legend's colour swatch. Identity is never colour alone: the name sits beside it. -->
    <Style x:Key="SeriesSwatch" TargetType="Border">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ChartSeries0Brush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Slot}" Value="1">
                <Setter Property="Background" Value="{DynamicResource ChartSeries1Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Slot}" Value="2">
                <Setter Property="Background" Value="{DynamicResource ChartSeries2Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Slot}" Value="3">
                <Setter Property="Background" Value="{DynamicResource ChartSeries3Brush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ui:ActivityChart">
        <Setter Property="Series0Brush" Value="{DynamicResource ChartSeries0Brush}" />
        <Setter Property="Series1Brush" Value="{DynamicResource ChartSeries1Brush}" />
        <Setter Property="Series2Brush" Value="{DynamicResource ChartSeries2Brush}" />
        <Setter Property="Series3Brush" Value="{DynamicResource ChartSeries3Brush}" />
        <Setter Property="LineBrush" Value="{DynamicResource ChartLineBrush}" />
        <Setter Property="GridBrush" Value="{DynamicResource ChartGridBrush}" />
        <Setter Property="AxisBrush" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="SurfaceBrush" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="HoverBrush" Value="{DynamicResource ChartHoverBrush}" />
        <Setter Property="TipBackground" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="TipBorder" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="TipText" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ui:Sparkline">
        <Setter Property="Stroke" Value="{DynamicResource ChartSeries0Brush}" />
    </Style>

    <!-- ===== View states: one loading / empty / error presentation for every screen ===== -->
    <Style TargetType="ui:StateHost">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:StateHost">
                    <Grid>
                        <ContentPresenter x:Name="Body" />
                        <StackPanel x:Name="Panel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                    Visibility="Collapsed" Margin="24">
                            <Border x:Name="Badge" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center"
                                    Background="{DynamicResource NeutralSoftBrush}" Margin="{StaticResource GapBottom12}">
                                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="{TemplateBinding EmptyGlyph}" />
                            </Border>
                            <TextBlock x:Name="Title" Style="{StaticResource TextHeading}" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Text="{TemplateBinding EmptyTitle}" />
                            <TextBlock x:Name="Message" Style="{StaticResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,6,0,0" Text="{TemplateBinding EmptyText}" />
                            <Border x:Name="Track" Width="120" Height="3" Margin="0,14,0,0" CornerRadius="1.5" ClipToBounds="True"
                                    Background="{DynamicResource NeutralSoftBrush}" Visibility="Collapsed">
                                <Border x:Name="Runner" Width="36" HorizontalAlignment="Left" CornerRadius="1.5"
                                        Background="{DynamicResource AccentBrush}">
                                    <Border.RenderTransform>
                                        <TranslateTransform />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <Button x:Name="Retry" Content="Retry" Margin="0,14,0,0" HorizontalAlignment="Center"
                                    ui:Ui.Icon="{StaticResource GlyphRefresh}" Command="{TemplateBinding RetryCommand}"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Empty">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Panel" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="Loading">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Panel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Title" Property="Text" Value="{Binding LoadingText, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Track" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="Error">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Panel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AttackSoftBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AttackTextBrush}" />
                            <Setter TargetName="Glyph" Property="Text" Value="{StaticResource GlyphError}" />
                            <Setter TargetName="Title" Property="Text" Value="{Binding ErrorTitle, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Message" Property="Text" Value="{Binding ErrorText, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Retry" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="State" Value="Loading" />
                                <Condition Property="AnimateLoading" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="Run">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Runner"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-36" To="120" Duration="0:0:1.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Run" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
