<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WinGuard dark theme brushes (PLAN.md §9). Keys are shared with Light.xaml. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1E22" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF25252B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF2D2D34" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF35353D" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFF0F0F2" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FFA0A0AA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3F3F48" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF22C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFEF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#FF383842" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#FF3B3B46" />
    <SolidColorBrush x:Key="ControlTrackBrush" Color="#FF4A4A55" />
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FF1E1E22" />

</ResourceDictionary>