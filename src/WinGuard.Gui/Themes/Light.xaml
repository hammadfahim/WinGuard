<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme. Keys are shared with Dark.xaml and HighContrast.xaml. Text and status colours
         are darker than their dark-theme siblings so every pairing keeps at least 4.5:1. -->

    <!-- Surfaces, lowest to highest. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#FFF2F4F7" />
    <SolidColorBrush x:Key="RailBrush" Color="#FFFAFBFC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FFF4F6F8" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFECF0F4" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#FFE0E6EC" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#FFDAEEF7" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#73121A22" />

    <!-- Lines. -->
    <SolidColorBrush x:Key="LineBrush" Color="#FFDFE4EA" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#FFBAC4CE" />
    <SolidColorBrush x:Key="HoverLineBrush" Color="#FF8E9BA8" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#FF0B6E99" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#00000000" />

    <!-- Text. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF121A22" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF44515D" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF5E6B78" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextOnSelectedBrush" Color="#FF121A22" />

    <!-- Accent: interactive, never a status. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0B6E99" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF095C80" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF074B69" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFE0F1F8" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF09628A" />

    <!-- Meaning. Each has a solid, a tinted background, readable text on the tint, and text on the solid. -->
    <SolidColorBrush x:Key="ProtectedBrush" Color="#FF0E8A5F" />
    <SolidColorBrush x:Key="ProtectedSoftBrush" Color="#FFDFF4EB" />
    <SolidColorBrush x:Key="ProtectedTextBrush" Color="#FF0A6545" />
    <SolidColorBrush x:Key="OnProtectedBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="AttackBrush" Color="#FFCF3A33" />
    <SolidColorBrush x:Key="AttackSoftBrush" Color="#FFFBE6E4" />
    <SolidColorBrush x:Key="AttackTextBrush" Color="#FFA82622" />
    <SolidColorBrush x:Key="OnAttackBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="WarnBrush" Color="#FFB87400" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFFCF0DA" />
    <SolidColorBrush x:Key="WarnTextBrush" Color="#FF7E4E00" />
    <SolidColorBrush x:Key="OnWarnBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#FFE9EDF1" />

    <!-- Charts: the same hue per engine as the dark theme, stepped for a light surface. -->
    <SolidColorBrush x:Key="ChartSeries0Brush" Color="#FF2A78D6" />
    <SolidColorBrush x:Key="ChartSeries1Brush" Color="#FFA8682A" />
    <SolidColorBrush x:Key="ChartSeries2Brush" Color="#FF6250D6" />
    <SolidColorBrush x:Key="ChartSeries3Brush" Color="#FFD6478A" />
    <SolidColorBrush x:Key="ChartLineBrush" Color="#FFCF3A33" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#FFE7EBEF" />
    <SolidColorBrush x:Key="ChartHoverBrush" Color="#1A0B6E99" />

    <!-- Scroll bars. -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FFC4CDD6" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF9AA7B3" />

    <!-- Elevation: only overlays (dialog, toast, menus) lift off the page. -->
    <DropShadowEffect x:Key="ElevationOverlay" BlurRadius="20" ShadowDepth="4" Direction="270"
                      Opacity="0.18" Color="#FF121A22" RenderingBias="Performance" />

</ResourceDictionary>
