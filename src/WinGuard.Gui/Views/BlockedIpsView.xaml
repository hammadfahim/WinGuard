<UserControl x:Class="WinGuard.Gui.Views.BlockedIpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Blocked IPs" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox Width="240" VerticalAlignment="Center"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by IP, source or note" />
                <Button Content="Export CSV…" Margin="8,0,0,0" Command="{Binding ExportCsvCommand}" />
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Bans}" SelectedItem="{Binding SelectedBan}"
                  IsReadOnly="True" SelectionMode="Single"
                  PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Unblock"
                              Command="{Binding PlacementTarget.DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Unblock &amp; Whitelist"
                              Command="{Binding PlacementTarget.DataContext.UnblockAndWhitelistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Promote to permanent"
                              Command="{Binding PlacementTarget.DataContext.PromoteToPermanentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="160" />
                <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="90" />
                <DataGridTextColumn Header="Banned (local)" Binding="{Binding BannedText}" Width="180" />
                <DataGridTextColumn Header="Expires (local)" Binding="{Binding ExpiresText}" Width="180" />
                <DataGridTextColumn Header="Offense" Binding="{Binding OffenseCount}" Width="80" />
                <DataGridTextColumn Header="Note" Binding="{Binding NoteText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,10,0,0"
                   Foreground="{DynamicResource SubtleForegroundBrush}" />
    </Grid>
</UserControl>