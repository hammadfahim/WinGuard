<UserControl x:Class="WinGuard.Gui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinGuard.Gui.Controls">

    <UserControl.Resources>
        <!-- One KPI tile. The DataContext is a KpiTile. -->
        <DataTemplate x:Key="KpiContent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="{StaticResource GapBottom4}">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,7,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Title}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Style="{StaticResource TextMetric}" Text="{Binding Value}" />
                <ui:Sparkline Grid.Row="1" Grid.Column="1" Width="72" Height="30" VerticalAlignment="Center" Margin="8,0,0,0"
                              Values="{Binding Trend}"
                              Visibility="{Binding Trend, Converter={StaticResource NotEmptyToVis}}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource TextCaption}" Text="{Binding Detail}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PagePadding}">

            <!-- Header -->
            <DockPanel Margin="{StaticResource GapBottom16}">
                <TextBlock Style="{StaticResource TextTitle}" Text="Dashboard" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding StartedText}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource TextCaption}" Text=" · " VerticalAlignment="Center"
                               Visibility="{Binding StartedText, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding VersionText}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- A possible compromise: the one event that outranks everything else on this page. -->
            <Border Style="{StaticResource Callout}" ui:Ui.Tone="Attack" BorderBrush="{DynamicResource AttackBrush}" Padding="14,10"
                    Margin="{StaticResource GapBottom12}" AutomationProperties.LiveSetting="Assertive"
                    AutomationProperties.Name="{Binding CompromiseTitle}"
                    Visibility="{Binding HasCompromiseAlerts, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ToneIcon}" ui:Ui.Tone="Attack" Text="{StaticResource GlyphWarning}" FontSize="17"
                               VerticalAlignment="Top" Margin="0,1,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource TextStrong}" FontSize="{StaticResource FontSizeHeading}" Text="{Binding CompromiseTitle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource TextBody}" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,2,0,6"
                                   Text="Check that each logon was really that person. If not, change the password and block the address." />
                        <ItemsControl ItemsSource="{Binding CompromiseAlerts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TextBody}" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource TextCaption}" Text="{Binding AgoText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <Button Grid.Column="2" Height="{StaticResource ControlHeightSmall}" Margin="12,0,0,0" Content="Show events"
                                                Command="{Binding DataContext.OpenAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="See everything from this address in the Event Log" />
                                        <Button Grid.Column="3" Style="{StaticResource IconButtonSmall}" ui:Ui.Icon="{StaticResource GlyphClose}" FontSize="10" Margin="4,0,0,0"
                                                Command="{Binding DataContext.DismissAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Dismiss. The event stays in the log" AutomationProperties.Name="Dismiss this alert" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The firewall policy: when it applies, nothing else on this page is worth much. -->
            <Border Style="{StaticResource Callout}" ui:Ui.Tone="{Binding FirewallPolicyTone}" Padding="14,10" Margin="{StaticResource GapBottom12}"
                    Visibility="{Binding HasFirewallPolicyWarnings, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ToneIcon}" ui:Ui.Tone="{Binding FirewallPolicyTone}" Text="{StaticResource GlyphWarning}" FontSize="17"
                               VerticalAlignment="Top" Margin="0,1,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource TextStrong}" FontSize="{StaticResource FontSizeHeading}" Text="{Binding FirewallPolicyTitle}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding FirewallPolicyWarnings}" Focusable="False" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource TextBody}" Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hero: where things stand, and what is happening right now. -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="{StaticResource GapBottom12}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="340" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="22,20,18,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="76" Height="84" VerticalAlignment="Top" Margin="0,2,18,0">
                            <Path Style="{StaticResource ToneShield}" ui:Ui.Tone="{Binding Protection.Tone}" />
                            <TextBlock Style="{StaticResource ToneIcon}" ui:Ui.Tone="{Binding Protection.Tone}" Text="{Binding Protection.Glyph}"
                                       FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextDisplay}" Text="{Binding Protection.Title}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Protection.Detail}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding HeroLine}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HeroLine, Converter={StaticResource NotEmptyToVis}}" />

                            <ItemsControl ItemsSource="{Binding Facts}" Margin="0,10,0,0" Focusable="False"
                                          Visibility="{Binding Facts.Count, Converter={StaticResource NotEmptyToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource Chip}" ui:Ui.Tone="{Binding Tone}" Content="{Binding Text}"
                                                        Margin="0,0,6,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource ToneText}" ui:Ui.Tone="Warn" Text="{Binding VersionMismatchText}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Visibility="{Binding VersionMismatchText, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,16,20,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="136" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="{StaticResource GapBottom8}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource ChartSeries0Brush}" Margin="0,0,6,0" />
                                    <TextBlock Style="{StaticResource TextCaption}" Text="Detections" Margin="0,0,14,0" />
                                    <Border Width="12" Height="2" CornerRadius="1" Background="{DynamicResource ChartLineBrush}" Margin="0,0,6,0" />
                                    <TextBlock Style="{StaticResource TextCaption}" Text="Blocks" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TextStrong}" Text="Live activity" />
                                    <TextBlock Style="{StaticResource TextCaption}" Text="last 60 minutes" Margin="8,1,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ui:ActivityChart Grid.Row="1" Data="{Binding LiveActivity}"
                                              AutomationProperties.Name="Live activity chart"
                                              AutomationProperties.HelpText="{Binding LiveSummary}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Prerequisite warnings -->
            <Border Style="{StaticResource Callout}" ui:Ui.Tone="Warn" Margin="{StaticResource GapBottom12}"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ToneIcon}" ui:Ui.Tone="Warn" Text="{StaticResource GlyphWarning}"
                               VerticalAlignment="Top" Margin="0,2,10,0" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Warnings}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource TextBody}" Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- KPI tiles: each one opens the page behind its number. -->
            <UniformGrid Columns="4" Margin="{StaticResource GapBottom12}">
                <Button Style="{StaticResource CardButton}" Margin="0,0,6,0" Padding="16,12" Command="{Binding OpenBansCommand}"
                        Content="{Binding ActiveBansKpi}" ContentTemplate="{StaticResource KpiContent}"
                        ToolTip="Open Blocked IPs" AutomationProperties.Name="{Binding ActiveBansKpi.AccessibleName}" />
                <Button Style="{StaticResource CardButton}" Margin="6,0" Padding="16,12" Command="{Binding OpenStatisticsCommand}"
                        Content="{Binding DetectionsKpi}" ContentTemplate="{StaticResource KpiContent}"
                        ToolTip="Open Statistics" AutomationProperties.Name="{Binding DetectionsKpi.AccessibleName}" />
                <Button Style="{StaticResource CardButton}" Margin="6,0" Padding="16,12" Command="{Binding OpenStatisticsCommand}"
                        Content="{Binding BansTodayKpi}" ContentTemplate="{StaticResource KpiContent}"
                        ToolTip="Open Statistics" AutomationProperties.Name="{Binding BansTodayKpi.AccessibleName}" />
                <Button Style="{StaticResource CardButton}" Margin="6,0,0,0" Padding="16,12" Command="{Binding OpenBansCommand}"
                        Content="{Binding RepeatKpi}" ContentTemplate="{StaticResource KpiContent}"
                        ToolTip="Addresses banned more than once. Open Blocked IPs" AutomationProperties.Name="{Binding RepeatKpi.AccessibleName}" />
            </UniformGrid>

            <!-- Engines -->
            <TextBlock Style="{StaticResource TextOverline}" Text="ENGINES" Margin="2,4,0,6" />
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" Margin="-6,0,-6,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,0">
                            <Button Style="{StaticResource CardButton}" Padding="14,12"
                                    Command="{Binding DataContext.OpenEngineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="See this engine's events"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,44,8">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Style="{StaticResource TextStrong}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource GapBottom8}">
                                        <Ellipse Style="{StaticResource ToneDot}" ui:Ui.Tone="{Binding Tone}" Margin="0,0,7,0" />
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding RunningText}" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TextHeading}" FontWeight="Normal" FontSize="18" Text="{Binding DetectionsToday, StringFormat={}{0:N0}}" />
                                            <TextBlock Style="{StaticResource TextCaption}" Text="detections" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource TextHeading}" FontWeight="Normal" FontSize="18" Text="{Binding ActiveBans, StringFormat={}{0:N0}}" />
                                            <TextBlock Style="{StaticResource TextCaption}" Text="bans" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Button>
                            <CheckBox Style="{StaticResource Toggle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}" ToolTip="Enable or disable this engine"
                                      AutomationProperties.Name="{Binding Name, StringFormat='{}{0} engine enabled'}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Feeds -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="10,12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="View all" Command="{Binding OpenBansCommand}" />
                            <TextBlock Style="{StaticResource TextStrong}" Text="Recent blocks" />
                        </DockPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource TextMuted}" Text="Nothing blocked right now." Margin="8,12"
                                       Visibility="{Binding HasRecentBlocks, Converter={StaticResource InverseBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding RecentBlocks}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}"
                                                Command="{Binding DataContext.OpenBansCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding IpAddress}"
                                                ToolTip="Find this ban in Blocked IPs"
                                                AutomationProperties.Name="{Binding IpAddress, StringFormat='Blocked {0}'}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource TextMono}" Text="{Binding IpAddress}" TextTrimming="CharacterEllipsis" />
                                                <ContentControl Grid.Column="1" Style="{StaticResource Chip}" ui:Ui.Tone="Attack" Content="Permanent" Margin="8,0,0,0"
                                                                Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}" Text="{Binding SourceText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource TextCaption}" Text="{Binding AgoText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           MinWidth="56" TextAlignment="Right" ToolTip="{Binding OffenseText}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Statistics" Command="{Binding OpenStatisticsCommand}" />
                            <TextBlock Style="{StaticResource TextStrong}" Text="Top attackers" />
                        </DockPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource TextMuted}" Text="No repeat attackers yet." Margin="8,12"
                                       Visibility="{Binding HasTopAttackers, Converter={StaticResource InverseBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding TopAttackers}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}"
                                                Command="{Binding DataContext.OpenBansCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding IpAddress}"
                                                ToolTip="{Binding LastSeenText, StringFormat='Last seen {0}'}"
                                                AutomationProperties.Name="{Binding IpAddress}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextCaption}" Text="{Binding BanText}" Margin="8,0,0,0" />
                                                    <TextBlock Style="{StaticResource TextMono}" Text="{Binding IpAddress}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource ShareBar}" Height="3" Value="{Binding Fraction, Mode=OneWay}"
                                                             Foreground="{DynamicResource ChartLineBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
