<UserControl x:Class="WinGuard.Gui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />

            <!-- Prerequisite warnings -->
            <Border CornerRadius="8" Padding="14" Margin="0,0,0,16" Background="{DynamicResource WarningBrush}"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Attention required" FontWeight="Bold"
                               Foreground="{DynamicResource WarningForegroundBrush}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningForegroundBrush}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Service status -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="Service" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                        <Border CornerRadius="12" Padding="12,5" HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource OnAccentForegroundBrush}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding VersionText}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StartedText}" Foreground="{DynamicResource SubtleForegroundBrush}" />
                            <TextBlock Foreground="{DynamicResource SubtleForegroundBrush}"
                                       Text="{Binding TotalActiveBansText, StringFormat='Active bans: {0}'}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="The WinGuard service is not running. Start it to begin protection."
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Button Content="Start service" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding StartServiceCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding VersionMismatchText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ErrorBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ServiceActionMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Protocol tiles -->
            <TextBlock Text="Detection engines" Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,8" />
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              ToolTip="Enable / disable this engine" />
                                </Grid>
                                <TextBlock Text="{Binding RunningText}" Foreground="{DynamicResource SubtleForegroundBrush}"
                                           Margin="0,4,0,12" />
                                <UniformGrid Columns="2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DetectionsToday}" FontSize="22" FontWeight="Bold" />
                                        <TextBlock Text="detections today" FontSize="11"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ActiveBans}" FontSize="22" FontWeight="Bold" />
                                        <TextBlock Text="active bans" FontSize="11"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recent activity -->
            <TextBlock Text="Recent activity" Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,8" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <TextBlock Text="No activity yet." Foreground="{DynamicResource SubtleForegroundBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentEvents}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding RecentEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                               Foreground="{DynamicResource SubtleForegroundBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SourceText}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>