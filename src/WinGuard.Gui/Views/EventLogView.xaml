<UserControl x:Class="WinGuard.Gui.Views.EventLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinGuard.Gui.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="ChipTemplate">
            <ToggleButton Style="{StaticResource FilterChip}" Content="{Binding Label}" ui:Ui.Badge="{Binding CountText}"
                          IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,0,6,4"
                          AutomationProperties.Name="{Binding Label, StringFormat='Show {0} events'}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ChipPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="{StaticResource GapBottom12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TextTitle}" Text="Event Log" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource TextMuted}" Text="{Binding CountText}" Margin="12,5,0,0" VerticalAlignment="Center" />
                <ContentControl Style="{StaticResource Chip}" ui:Ui.Tone="Warn" Content="Paused" Margin="12,4,0,0"
                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBox Style="{StaticResource SearchBox}" Width="240" ui:Ui.Placeholder="Search address or message"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter as you type (Ctrl+F)" AutomationProperties.Name="Search events" />
                <Button Margin="8,0,0,0" Content="{Binding PauseText}" ui:Ui.Icon="{Binding PauseGlyph}"
                        Command="{Binding TogglePauseCommand}" ToolTip="Freeze the list while you read; new events wait" />
                <Button Margin="8,0,0,0" Content="Export" ui:Ui.Icon="{StaticResource GlyphExport}"
                        Command="{Binding ExportCsvCommand}" ToolTip="Save the rows shown to a CSV file" />
                <Button Margin="8,0,0,0" Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource GlyphDelete}"
                        Command="{Binding ClearCommand}" ToolTip="Clear this view. The service keeps its history"
                        AutomationProperties.Name="Clear this view" />
            </StackPanel>
        </Grid>

        <!-- Filter chips -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding LevelChips}" ItemTemplate="{StaticResource ChipTemplate}"
                          ItemsPanel="{StaticResource ChipPanel}" Focusable="False" />
            <Rectangle Width="1" Margin="4,3,10,7" Fill="{DynamicResource LineStrongBrush}" />
            <ItemsControl ItemsSource="{Binding SourceChips}" ItemTemplate="{StaticResource ChipTemplate}"
                          ItemsPanel="{StaticResource ChipPanel}" Focusable="False" />
        </WrapPanel>

        <!-- Feed -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ui:StateHost State="{Binding State}" EmptyGlyph="{StaticResource GlyphEvents}" EmptyTitle="{Binding EmptyTitle}" EmptyText="{Binding EmptyText}"
                          ErrorTitle="The event log is not available" ErrorText="{Binding ErrorText}"
                          RetryCommand="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ui:PageHost}}"
                          LoadingText="Loading events…">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Height="34" Padding="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="146" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Text="Time" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Text="Level" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Text="Engine" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Text="Address" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Text="Message" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="EventsList" Grid.Row="1" ItemsSource="{Binding Events}" SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource FeedRow}"
                             VirtualizingPanel.ScrollUnit="Item"
                             ScrollViewer.CanContentScroll="True"
                             AutomationProperties.Name="Events, oldest first"
                             KeyDown="OnListKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy event" ui:Ui.Icon="{StaticResource GlyphCopy}" InputGestureText="Ctrl+C"
                                          Command="{Binding PlacementTarget.DataContext.CopyRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Copy address" ui:Ui.Icon="{StaticResource GlyphCopy}"
                                          Command="{Binding PlacementTarget.DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Show only this address" ui:Ui.Icon="{StaticResource GlyphSearch}"
                                          Command="{Binding PlacementTarget.DataContext.SearchIpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="146" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FeedToneIcon}" ui:Ui.Tone="{Binding Tone}" Text="{Binding Glyph}" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource FeedMuted}" Text="{Binding TimeText}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource FeedTone}" ui:Ui.Tone="{Binding Tone}" Text="{Binding LevelText}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource FeedMuted}" Text="{Binding SourceText}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource CellMono}" Text="{Binding IpAddress}" Margin="0,0,12,0" ToolTip="{Binding IpAddress}" />
                                    <TextBlock Grid.Column="5" Style="{StaticResource CellText}" Text="{Binding Message}" Margin="0,0,12,0" ToolTip="{Binding Message}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- The pill -->
                    <Button Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                            Style="{StaticResource PrimaryButton}" Height="28" Padding="14,0"
                            Content="{Binding PillText}" ui:Ui.Icon="{StaticResource GlyphArrowDown}"
                            Command="{Binding JumpToLatestCommand}" ToolTip="Jump to the newest event"
                            Visibility="{Binding HasUnseen, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </ui:StateHost>
        </Border>
    </Grid>
</UserControl>
