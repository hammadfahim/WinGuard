<UserControl x:Class="WinGuard.Gui.Views.EventLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Event Log" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Level" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <ComboBox Width="110" ItemsSource="{Binding LevelFilters}"
                          SelectedItem="{Binding SelectedLevelFilter, Mode=TwoWay}" />
                <TextBlock Text="Source" VerticalAlignment="Center" Margin="12,0,6,0"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <ComboBox Width="120" ItemsSource="{Binding SourceFilters}"
                          SelectedItem="{Binding SelectedSourceFilter, Mode=TwoWay}" />
                <CheckBox Content="Auto-scroll" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsChecked="{Binding AutoScroll, Mode=TwoWay}" />
                <Button Content="Clear" Margin="8,0,0,0" Command="{Binding ClearCommand}" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Export CSV…" Margin="8,0,0,0" Command="{Binding ExportCsvCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource SubtleForegroundBrush}" />
            <TextBox VerticalAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Show only events whose IP or message contains this text" />
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="4">
            <ListBox x:Name="EventsList" ItemsSource="{Binding Events}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="165" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource InfoBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                       Foreground="{DynamicResource SubtleForegroundBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding LevelText}" />
                            <TextBlock Grid.Column="3" Text="{Binding SourceText}" />
                            <TextBlock Grid.Column="4" Text="{Binding IpAddress}" />
                            <TextBlock Grid.Column="5" Text="{Binding Message}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Foreground="{DynamicResource SubtleForegroundBrush}"
                       Text="{Binding VisibleCount, StringFormat='Showing {0} event(s)'}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>