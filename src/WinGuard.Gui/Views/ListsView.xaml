<UserControl x:Class="WinGuard.Gui.Views.ListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinGuard.Gui.Controls">

    <UserControl.Resources>
        <!-- One list. The DataContext is a ListPanelViewModel. -->
        <DataTemplate x:Key="ListPanel">
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="16,14,16,10">
                        <DockPanel Margin="{StaticResource GapBottom4}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButtonSmall}" ui:Ui.Icon="{StaticResource GlyphPaste}" Command="{Binding PasteManyCommand}"
                                        ToolTip="Add many: review the addresses on the clipboard" AutomationProperties.Name="Paste many" />
                                <Button Style="{StaticResource IconButtonSmall}" ui:Ui.Icon="{StaticResource GlyphImport}" Command="{Binding ImportCommand}"
                                        ToolTip="Import from a text or CSV file" AutomationProperties.Name="Import" />
                                <Button Style="{StaticResource IconButtonSmall}" ui:Ui.Icon="{StaticResource GlyphExport}" Command="{Binding ExportCommand}"
                                        ToolTip="Export to a text file" AutomationProperties.Name="Export" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TextHeading}" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource TextMuted}" Text="{Binding CountText}" Margin="8,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Description}" TextWrapping="Wrap" Margin="{StaticResource GapBottom12}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddBox" Style="{StaticResource MonoBox}" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                                     ui:Ui.Placeholder="IP or CIDR, or paste many" ui:Ui.HasError="{Binding HasError}"
                                     Loaded="OnAddBoxLoaded"
                                     AutomationProperties.Name="{Binding Title, StringFormat='Add to {0}'}"
                                     ToolTip="One address or range. Paste a whole list and it is reviewed before anything is added">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{Binding AddLabel}"
                                    ui:Ui.Icon="{StaticResource GlyphAdd}" Command="{Binding AddCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource ToneText}" ui:Ui.Tone="{Binding FeedbackTone}" Text="{Binding Feedback}"
                                   TextWrapping="Wrap" Margin="2,5,0,0" FontSize="{StaticResource FontSizeCaption}"
                                   Visibility="{Binding Feedback, Converter={StaticResource NotEmptyToVis}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="16,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox ui:Ui.Icon="{StaticResource GlyphSearch}" ui:Ui.Clearable="True" ui:Ui.Placeholder="Filter this list" MinHeight="26" Height="26"
                                 FontSize="{StaticResource FontSizeCaption}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding Title, StringFormat='Filter {0}'}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Height="{StaticResource ControlHeightSmall}" Content="{Binding RemoveSelectedText}"
                                ui:Ui.Icon="{StaticResource GlyphDelete}" Command="{Binding RemoveSelectedCommand}"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                        <ui:StateHost State="{Binding State}" EmptyGlyph="{StaticResource GlyphLists}" EmptyTitle="{Binding EmptyTitle}" EmptyText="Add an address or a range above.">
                            <ListBox ItemsSource="{Binding Entries}" SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                                     ItemContainerStyle="{StaticResource FeedRow}" VirtualizingPanel.ScrollUnit="Item"
                                     ScrollViewer.CanContentScroll="True"
                                     AutomationProperties.Name="{Binding Title}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,0,8,0" ToolTip="{Binding ToolTipText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource CellMono}" Text="{Binding Value}" />
                                            <ContentControl Grid.Column="1" Style="{StaticResource Chip}" ui:Ui.Tone="Warn" Content="Overlaps whitelist" Margin="8,0,0,0"
                                                            Visibility="{Binding OverlapsWhitelist, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}" Text="{Binding KindText}" Margin="10,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource ListRowAction}" ui:Ui.Icon="{StaticResource GlyphCopy}"
                                                        ToolTip="Copy" AutomationProperties.Name="Copy"
                                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource ListRowAction}" ui:Ui.Icon="{StaticResource GlyphDelete}"
                                                        ToolTip="Remove" AutomationProperties.Name="Remove"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ui:StateHost>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="{StaticResource GapBottom12}">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource GlyphRefresh}" Command="{Binding RefreshCommand}"
                    ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh lists" />
            <TextBlock Style="{StaticResource TextTitle}" Text="Lists" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Overlap warning -->
        <Border Grid.Row="1" Style="{StaticResource Callout}" ui:Ui.Tone="Warn" Margin="{StaticResource GapBottom12}"
                Visibility="{Binding OverlapWarning, Converter={StaticResource NotEmptyToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource ToneIcon}" ui:Ui.Tone="Warn" Text="{StaticResource GlyphWarning}" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource TextBody}" Text="{Binding OverlapWarning}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Review of a paste or an import -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="{StaticResource GapBottom12}" DataContext="{Binding Review}"
                Visibility="{Binding DataContext.Review, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotEmptyToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextHeading}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource TextMono}" Text="{Binding PreviewText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Summary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource ToneText}" ui:Ui.Tone="Warn" Text="{Binding OverlapText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding OverlapText, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Rejected}" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ToneText}" ui:Ui.Tone="Attack" Text="{Binding}" FontSize="{StaticResource FontSizeCaption}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelCommand}" Margin="{StaticResource GapRight8}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding CommitText}" Command="{Binding CommitCommand}"
                            IsEnabled="{Binding CanCommit}" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:StateHost Grid.Row="3" State="{Binding State}"
                      ErrorTitle="The lists are not available" ErrorText="{Binding ErrorText}"
                      RetryCommand="{Binding RefreshCommand}" LoadingText="Loading lists…">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding Whitelist}" ContentTemplate="{StaticResource ListPanel}" />
                <ContentPresenter Grid.Column="2" Content="{Binding Blacklist}" ContentTemplate="{StaticResource ListPanel}" />
            </Grid>
        </ui:StateHost>
    </Grid>
</UserControl>
