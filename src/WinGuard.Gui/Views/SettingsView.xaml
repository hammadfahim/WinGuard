<UserControl x:Class="WinGuard.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinGuard.Gui.Controls"
             xmlns:vm="clr-namespace:WinGuard.Gui.ViewModels">

    <UserControl.Resources>
        <!-- Shared left half of a setting row. -->
        <DataTemplate x:Key="FieldLabel">
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Style="{StaticResource TextBody}" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Help}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,10" />
        </Style>

        <DataTemplate DataType="{x:Type vm:ToggleField}">
            <StackPanel Margin="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldLabel}" />
                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" />
                </Grid>
                <Border Style="{StaticResource Callout}" ui:Ui.Tone="Warn" Margin="0,8,0,0" Padding="10,6"
                        Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource TextBody}" Text="{Binding WarningWhenOn}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextField}">
            <Grid Style="{StaticResource FieldRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldLabel}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{Binding Placeholder}"
                             ui:Ui.HasError="{Binding HasError}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" />
                    <TextBlock Style="{StaticResource ToneText}" ui:Ui.Tone="Attack" Text="{Binding Error}" TextWrapping="Wrap" Margin="2,4,0,0"
                               FontSize="{StaticResource FontSizeCaption}" Visibility="{Binding Error, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DurationField}">
            <Grid Style="{StaticResource FieldRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldLabel}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{Binding Placeholder}"
                             ui:Ui.HasError="{Binding HasError}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" />
                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Echo}" Margin="2,4,0,0"
                               Visibility="{Binding Echo, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource ToneText}" ui:Ui.Tone="Attack" Text="{Binding Error}" TextWrapping="Wrap" Margin="2,4,0,0"
                               FontSize="{StaticResource FontSizeCaption}" Visibility="{Binding Error, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SecretField}">
            <Grid Style="{StaticResource FieldRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldLabel}" />
                <PasswordBox Grid.Column="1" VerticalAlignment="Center" ui:SecretBinding.Secret="{Binding Text, Mode=TwoWay}"
                             AutomationProperties.Name="{Binding Label}" />
            </Grid>
        </DataTemplate>

        <!-- A heading for the full-width editors. -->
        <DataTemplate x:Key="BlockHeading">
            <StackPanel Margin="{StaticResource GapBottom8}">
                <TextBlock Style="{StaticResource TextBody}" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Help}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BanTiersField}">
            <StackPanel Margin="0,10">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeading}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{StaticResource GapBottom4}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Label}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ui:Ui.HasError="{Binding HasError}"
                                         AutomationProperties.Name="{Binding Label}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}" Text="{Binding Echo}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding Error, Converter={StaticResource EmptyToVis}}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ToneText}" ui:Ui.Tone="Attack" Text="{Binding Error}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeCaption}" />
                                <Button Grid.Column="3" Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource GlyphClose}" FontSize="11"
                                        Command="{Binding DataContext.RemoveTierCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="Remove this tier" AutomationProperties.Name="Remove this tier" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,6,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Add tier" ui:Ui.Icon="{StaticResource GlyphAdd}" Command="{Binding AddTierCommand}"
                            Height="{StaticResource ControlHeightSmall}" Margin="{StaticResource GapRight8}" />
                    <TextBlock Style="{StaticResource TextCaption}" Text="Presets:" VerticalAlignment="Center" Margin="4,0,8,0" />
                    <Button Height="{StaticResource ControlHeightSmall}" Content="24h, 7d, 30d" Command="{Binding PresetCommand}" CommandParameter="default" Margin="0,0,6,0" />
                    <Button Height="{StaticResource ControlHeightSmall}" Content="24h only" Command="{Binding PresetCommand}" CommandParameter="24h" Margin="0,0,6,0" />
                    <Button Height="{StaticResource ControlHeightSmall}" Content="7d only" Command="{Binding PresetCommand}" CommandParameter="7d" Margin="0,0,6,0" />
                    <Button Height="{StaticResource ControlHeightSmall}" Content="30d only" Command="{Binding PresetCommand}" CommandParameter="30d" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StringListField}">
            <StackPanel Margin="0,10">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeading}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{StaticResource GapBottom4}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource MonoBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         ui:Ui.Placeholder="{Binding DataContext.Placeholder, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         AutomationProperties.Name="{Binding DataContext.Label, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource GlyphClose}" FontSize="11" Margin="4,0,0,0"
                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="Remove" AutomationProperties.Name="Remove" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Height="{StaticResource ControlHeightSmall}" Margin="0,4,0,0"
                        Content="{Binding AddLabel}" ui:Ui.Icon="{StaticResource GlyphAdd}" Command="{Binding AddRowCommand}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FtpSourcesField}">
            <StackPanel Margin="0,10">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeading}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="{StaticResource GapBottom8}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="Name" AutomationProperties.Name="Source name" />
                                    <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{x:Static vm:FtpSourcesField.Kinds}" SelectedValuePath="Kind" DisplayMemberPath="Label" SelectedValue="{Binding Kind, Mode=TwoWay}"
                                              AutomationProperties.Name="Server kind" />
                                    <TextBox Grid.Column="2" Style="{StaticResource MonoBox}" Margin="6,0,0,0" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                             ui:Ui.Placeholder="C:\inetpub\logs\LogFiles\FTPSVC1" ui:Ui.HasError="{Binding HasError}"
                                             AutomationProperties.Name="Log path" />
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource GlyphClose}" FontSize="11" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="Remove this source" AutomationProperties.Name="Remove this source" />
                                </Grid>
                                <TextBlock Style="{StaticResource ToneText}" ui:Ui.Tone="Attack" Text="{Binding PathError}" Margin="266,4,0,0" FontSize="{StaticResource FontSizeCaption}"
                                           Visibility="{Binding PathError, Converter={StaticResource NotEmptyToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Style="{StaticResource GhostButton}" Height="{StaticResource ControlHeightSmall}" Content="Add source" ui:Ui.Icon="{StaticResource GlyphAdd}"
                            Command="{Binding AddSourceCommand}" Margin="{StaticResource GapRight8}" />
                    <Button Style="{StaticResource GhostButton}" Height="{StaticResource ControlHeightSmall}" Content="Detect IIS FTP logs" ui:Ui.Icon="{StaticResource GlyphSearch}"
                            Command="{Binding DetectIisCommand}" ToolTip="Adds the FTPSVC* folders found under %SystemDrive%\inetpub\logs\LogFiles" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CustomSourcesField}">
            <StackPanel Margin="0,10">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeading}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                                    Background="{DynamicResource SurfaceSunkenBrush}" Margin="{StaticResource GapBottom8}">
                                <StackPanel>
                                    <Grid Margin="12,8,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=TwoWay}" ToolTip="Whether this source is read"
                                                  AutomationProperties.Name="{Binding Title, StringFormat='{}{0} enabled'}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource TextStrong}" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ToggleButton Grid.Column="2" Style="{StaticResource FilterChip}" Content="Edit and test" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource GlyphClose}" FontSize="11" Margin="4,0,0,0"
                                                Height="{StaticResource ControlHeightSmall}" Width="{StaticResource ControlHeightSmall}"
                                                Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Remove this source" AutomationProperties.Name="Remove this source" />
                                    </Grid>

                                    <StackPanel Margin="12,0,12,12" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource TextCaption}" Text="Name" Margin="{StaticResource GapBottom4}" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource GapBottom8}" AutomationProperties.Name="Source name" />

                                        <TextBlock Style="{StaticResource TextCaption}" Text="File or folder and pattern (local drive)" Margin="{StaticResource GapBottom4}" />
                                        <TextBox Style="{StaticResource MonoBox}" Text="{Binding PathGlob, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="C:\logs\app\*.log"
                                                 ui:Ui.HasError="{Binding PathError, Converter={StaticResource NotEmptyToBool}}" AutomationProperties.Name="Log path" />
                                        <TextBlock Style="{StaticResource ToneText}" ui:Ui.Tone="Attack" Text="{Binding PathError}" Margin="2,4,0,0" FontSize="{StaticResource FontSizeCaption}"
                                                   Visibility="{Binding PathError, Converter={StaticResource NotEmptyToVis}}" />

                                        <TextBlock Style="{StaticResource TextCaption}" Text="Regex" Margin="0,8,0,4" />
                                        <TextBox Style="{StaticResource MonoBox}" Text="{Binding Regex, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="8,6"
                                                 ui:Ui.HasError="{Binding RegexError, Converter={StaticResource NotEmptyToBool}}" AutomationProperties.Name="Regex" />
                                        <TextBlock Style="{StaticResource ToneText}" ui:Ui.Tone="Attack" Text="{Binding RegexError}" Margin="2,4,0,0" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap"
                                                   Visibility="{Binding RegexError, Converter={StaticResource NotEmptyToVis}}" />

                                        <TextBlock Style="{StaticResource TextCaption}" Text="Test against a sample line" Margin="0,8,0,4" />
                                        <TextBox Style="{StaticResource MonoBox}" Text="{Binding SampleLine, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="8,6"
                                                 ui:Ui.Placeholder="Paste a line from the log" AutomationProperties.Name="Sample log line" />

                                        <Border Style="{StaticResource Callout}" ui:Ui.Tone="{Binding ResultTone}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextBody}" Text="{Binding Result.Summary}" TextWrapping="Wrap" />
                                                <Grid Margin="0,6,0,0" Visibility="{Binding HasCapture, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource TextCaption}" Text="Captured address" />
                                                        <TextBlock Style="{StaticResource TextMono}" Text="{Binding Result.IpAddress}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Style="{StaticResource TextCaption}" Text="Captured user" />
                                                        <TextBlock Style="{StaticResource TextMono}" Text="{Binding Result.UserName, TargetNullValue='(none)', FallbackValue='(none)'}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Height="{StaticResource ControlHeightSmall}" Content="Add source" ui:Ui.Icon="{StaticResource GlyphAdd}"
                            Command="{Binding AddSourceCommand}" />
                    <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:CustomSourcesField.Recipes}" SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                              DisplayMemberPath="Name" AutomationProperties.Name="Recipe" ToolTip="Ready-made sources for common servers. Adjust the path to this machine" />
                    <Button Grid.Column="3" Margin="8,0,0,0" Content="Add recipe" Command="{Binding AddFromRecipeCommand}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TextTitle}" Text="Settings" Margin="{StaticResource GapBottom12}" />

        <ui:StateHost Grid.Row="1" State="{Binding State}"
                      ErrorTitle="Settings are not available" ErrorText="{Binding ErrorText}"
                      RetryCommand="{Binding ReloadCommand}" LoadingText="Loading settings…">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Side navigation -->
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" ui:Ui.Placeholder="Search settings" Margin="{StaticResource GapBottom8}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter settings as you type (Ctrl+F)" AutomationProperties.Name="Search settings" />
                    <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             AutomationProperties.Name="Settings sections" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Visibility" Value="{Binding IsListed, Converter={StaticResource BoolToVis}}" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Ellipse Grid.Column="2" Style="{StaticResource ToneDot}" ui:Ui.Tone="Accent" ToolTip="Unsaved changes"
                                             Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                    <Ellipse Grid.Column="2" Style="{StaticResource ToneDot}" ui:Ui.Tone="Attack" ToolTip="Has a problem to fix"
                                             Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Sections -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Callout}" ui:Ui.Tone="Warn" Margin="{StaticResource GapBottom8}"
                            Visibility="{Binding RemoteChangePending, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap"
                                   Text="These settings changed outside this page while you were editing. Saving overwrites that change; Discard shows it." />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" Margin="0,0,8,0">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="{Binding IsShown, Converter={StaticResource BoolToVis}}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="{StaticResource GapBottom16}">
                                        <TextBlock Style="{StaticResource TextHeading}" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                        <Border Style="{StaticResource Card}" Padding="18,6">
                                            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Visibility" Value="{Binding IsShown, Converter={StaticResource BoolToVis}}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </ui:StateHost>

        <!-- Dirty bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}" Padding="14,8" Margin="0,10,0,0"
                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Discard" Command="{Binding DiscardCommand}" Margin="{StaticResource GapRight8}" ui:Ui.Icon="{StaticResource GlyphUndo}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save changes" Command="{Binding SaveCommand}" ui:Ui.Icon="{StaticResource GlyphSave}"
                            ToolTip="Save (Ctrl+S). The service applies them right away" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource ToneIcon}" ui:Ui.Tone="Warn" Text="{StaticResource GlyphWarning}" Margin="0,0,10,0"
                               Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource TextStrong}" Text="{Binding DirtyText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
