<UserControl x:Class="WinGuard.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinGuard.Gui.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="Settings" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Reset" HorizontalAlignment="Right" Command="{Binding ResetCommand}" />
            </DockPanel>

            <!-- General engine -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Engine" Style="{StaticResource SectionHeaderStyle}" />
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Failed-login threshold" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Count window (e.g. 00:10:00)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding CountWindowText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Expire time (e.g. 1.00:00:00)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ExpireTimeText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Housekeeping interval (e.g. 00:00:15)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding HousekeepingText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Max ban duration (e.g. 365.00:00:00)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding MaxBanDurationText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Event history (days)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding EventRetentionDaysText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="How long the service keeps entries shown in the Event Log" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Blocked ports (empty = all)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding BlockedPortsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Comma separated. Leave empty to block all ports. Example: 3389, 1433" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Backlog replay (minutes)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding EventBacklogReplayMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="How many minutes of event-log history to re-read when the service starts, covering failures logged while it was stopped. 0 = off." />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="IPv6 aggregate prefix" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Ipv6AggregatePrefixText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="0 = ban single IPv6 addresses. 64 = count and ban the whole /64 prefix, so address rotation cannot evade banning." />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Max addresses per firewall rule" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding MaxAddressesPerRuleText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Windows practical limit is 1000 addresses per rule; WinGuard batches into numbered rules automatically." />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClearBansOnStartup, Mode=TwoWay}" />
                        <TextBlock Text="Clear all bans on service startup" Margin="10,0,24,0" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ProcessInternalIPs, Mode=TwoWay}" />
                        <TextBlock Text="Process internal / private IPs" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Background="{DynamicResource WarningBrush}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                            Visibility="{Binding ReportOnly, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Report-only mode is ON: failures are counted and would-be bans are recorded, but the firewall is NOT modified."
                                   TextWrapping="Wrap" Foreground="Black" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReportOnly, Mode=TwoWay}" />
                        <TextBlock Text="Report-only mode (monitor without blocking)" Margin="10,0,0,0" VerticalAlignment="Center"
                                   ToolTip="Trial WinGuard safely: count failures and record would-be bans without touching the firewall" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Ban tiers -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ban tiers (escalation)" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Duration for each successive offense. Format: d.hh:mm:ss or hh:mm:ss."
                               Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="24h / 7d / 30d (default)" Command="{Binding PresetTiersDefaultCommand}" />
                        <Button Content="24h only" Margin="6,0,0,0" Command="{Binding PresetTiers24hCommand}" />
                        <Button Content="7d only" Margin="6,0,0,0" Command="{Binding PresetTiers7dCommand}" />
                        <Button Content="30d only" Margin="6,0,0,0" Command="{Binding PresetTiers30dCommand}" />
                        <Button Content="Add tier" Margin="6,0,0,0" Command="{Binding AddTierCommand}" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding BanTiers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Remove" Margin="6,0,0,0"
                                            Command="{Binding DataContext.RemoveTierCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- RDP -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="RDP" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RdpEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Enabled" Margin="10,0,24,0" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RdpUseRdpCoreTsFallback, Mode=TwoWay}" />
                        <TextBlock Text="Use RdpCoreTS/Operational 140 fallback" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Threshold override (empty = global)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding RdpThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Count window override (empty = global)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding RdpCountWindowText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Exclusion rules" FontWeight="SemiBold" Margin="0,4,0,2" />
                    <TextBlock Text="One rule per row. Comma = AND, separate rows = OR, '*' wildcard, '!=' negation. Example: LogonType=2, IpAddress=127.0.0.1"
                               Foreground="{DynamicResource SubtleForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Button Content="Add rule" HorizontalAlignment="Left" Command="{Binding AddExclusionCommand}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding RdpExclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Remove" Margin="6,0,0,0"
                                            Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- MS SQL -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="MS SQL" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MsSqlEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Enabled" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Threshold override (empty = global)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding MsSqlThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Count window override (empty = global)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding MsSqlCountWindowText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Ignore message patterns (literal substrings)" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <Button Content="Add pattern" HorizontalAlignment="Left" Command="{Binding AddIgnorePatternCommand}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding MsSqlIgnorePatterns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Remove" Margin="6,0,0,0"
                                            Command="{Binding DataContext.RemoveIgnorePatternCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- FTP -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="FTP" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FtpEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Enabled" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Threshold override (empty = global)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding FtpThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Count window override (empty = global)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding FtpCountWindowText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Poll interval (e.g. 00:00:03)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding FtpPollIntervalText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Log sources" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <DataGrid x:Name="FtpSourcesGrid" ItemsSource="{Binding FtpSources}" SelectedItem="{Binding SelectedFtpSource}" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="170" />
                            <DataGridComboBoxColumn Header="Kind" Width="130"
                                                    ItemsSource="{x:Static local:SettingsViewModel.FtpKinds}"
                                                    SelectedItemBinding="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Path (local drive)" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Add source" Command="{Binding AddFtpSourceCommand}" />
                        <Button Content="Detect IIS FTP logs" Margin="6,0,0,0" Command="{Binding DetectIisFtpCommand}"
                                ToolTip="Adds the FTPSVC* folders found under %SystemDrive%\inetpub\logs\LogFiles" />
                        <Button Content="Remove selected" Margin="6,0,0,0" Command="{Binding RemoveFtpSourceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Custom sources -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Custom log sources" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Regex must contain a named group (?&lt;ipaddress&gt;...) and may contain (?&lt;username&gt;...)."
                               Foreground="{DynamicResource SubtleForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <DataGrid x:Name="CustomSourcesGrid" ItemsSource="{Binding CustomSources}" SelectedItem="{Binding SelectedCustomSource}" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Path / glob (local drive)" Binding="{Binding PathGlob, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                            <DataGridTextColumn Header="Regex" Binding="{Binding Regex, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Add source" Command="{Binding AddCustomSourceCommand}" />
                        <Button Content="Remove selected" Margin="6,0,0,0" Command="{Binding RemoveCustomSourceCommand}" />
                    </StackPanel>
                    <TextBlock Text="Add from recipe" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <TextBlock Text="Pre-configured sources for common servers. The path still needs to match this machine."
                               Foreground="{DynamicResource SubtleForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="260" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
                                  DisplayMemberPath="Name" />
                        <Button Content="Add from recipe" Margin="6,0,0,0" Command="{Binding AddFromRecipeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Out-of-band alerts when WinGuard blocks or unblocks an attacker. All channels are opt-in and rate-limited; WinGuard itself never contacts anything but the destinations below."
                               Foreground="{DynamicResource SubtleForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Enable webhook / Telegram / e-mail" Margin="10,0,24,0" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WriteToWindowsEventLog, Mode=TwoWay}" />
                        <TextBlock Text="Write to Windows Event Log (Application)" Margin="10,0,0,0" VerticalAlignment="Center"
                                   ToolTip="Also records WinGuard events under the 'WinGuard' source so SIEM / Windows Event Forwarding can consume them" />
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Width="300" Margin="0,0,16,10">
                            <TextBlock Text="Webhook URL (JSON POST)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding WebhookUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="Telegram bot token" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="180" Margin="0,0,16,10">
                            <TextBlock Text="Telegram chat id" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,16,10">
                            <TextBlock Text="Rate limit (per minute)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding RateLimitPerMinuteText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="E-mail (SMTP)" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="SMTP host" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="100" Margin="0,0,16,10">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SmtpPortText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="180" Margin="0,0,16,10" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SmtpEnableSsl, Mode=TwoWay}" />
                                <TextBlock Text="Use TLS" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Width="180" Margin="0,0,16,10">
                            <TextBlock Text="Username (empty = anonymous)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SmtpUsername, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="180" Margin="0,0,16,10">
                            <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SmtpPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="From (e.g. winguard@example.com)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SmtpFrom, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,16,10">
                            <TextBlock Text="To" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SmtpTo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Save -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Save settings" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}"
                        Click="OnSaveClick" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>