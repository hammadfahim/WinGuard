<UserControl x:Class="WinGuard.Gui.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinGuard.Gui.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="StatTileTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource TextMetric}" FontSize="24" Text="{Binding Value}" />
                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="{StaticResource GapBottom12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TextTitle}" Text="Statistics" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="7 days" IsChecked="{Binding Is7Days, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="30 days" IsChecked="{Binding Is30Days, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="90 days" IsChecked="{Binding Is90Days, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
                <Button Margin="8,0,0,0" Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource GlyphRefresh}" Command="{Binding LoadCommand}"
                        ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh statistics" />
            </StackPanel>
        </Grid>

        <ui:StateHost Grid.Row="1" State="{Binding State}" EmptyGlyph="{StaticResource GlyphStatistics}"
                      EmptyTitle="No statistics yet" EmptyText="Daily counters and ban history build up as WinGuard sees attacks."
                      ErrorTitle="Statistics are not available" ErrorText="{Binding ErrorText}"
                      RetryCommand="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ui:PageHost}}"
                      LoadingText="Loading statistics…">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5*" MinHeight="210" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="4*" MinHeight="150" />
                </Grid.RowDefinitions>

                <!-- Headline figures -->
                <UniformGrid Columns="4" Margin="{StaticResource GapBottom12}">
                    <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,6,0">
                        <ContentPresenter Content="{Binding DetectionsTile}" ContentTemplate="{StaticResource StatTileTemplate}" />
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,8" Margin="6,0">
                        <ContentPresenter Content="{Binding BansTile}" ContentTemplate="{StaticResource StatTileTemplate}" />
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,8" Margin="6,0">
                        <ContentPresenter Content="{Binding PeakTile}" ContentTemplate="{StaticResource StatTileTemplate}" />
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,8" Margin="6,0,0,0">
                        <ContentPresenter Content="{Binding ActiveTile}" ContentTemplate="{StaticResource StatTileTemplate}" />
                    </Border>
                </UniformGrid>

                <!-- Charts and breakdown -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="232" />
                    </Grid.ColumnDefinitions>

                    <!-- Two charts, one scale each: bans are far fewer than detections, so one plot
                         would flatten them, and two axes on one plot would invent a correlation. -->
                    <Border Style="{StaticResource Card}" Padding="16,12,16,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource TextStrong}" Text="Detections per day" Margin="{StaticResource GapBottom4}" />
                            <ui:ActivityChart Grid.Row="1" Data="{Binding DetectionsChart}"
                                              AutomationProperties.Name="Detections per day"
                                              AutomationProperties.HelpText="{Binding ChartSummary}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource TextStrong}" Text="Bans per day" Margin="0,8,0,4" />
                            <ui:ActivityChart Grid.Row="3" Data="{Binding BansChart}"
                                              AutomationProperties.Name="Bans per day"
                                              AutomationProperties.HelpText="{Binding ChartSummary}" />
                        </Grid>
                    </Border>

                    <!-- Per-engine breakdown: also the legend, and a filter for the charts. -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextStrong}" Text="By engine" Margin="{StaticResource GapBottom4}" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextCaption}" Text="Switch an engine off to hide it" Margin="{StaticResource GapBottom8}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Engines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="{StaticResource GapBottom12}">
                                            <DockPanel Margin="{StaticResource GapBottom4}">
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in the charts'}"
                                                          ToolTip="Show or hide this engine in the charts" />
                                                <Border Style="{StaticResource SeriesSwatch}" Margin="0,0,7,0" />
                                                <TextBlock Style="{StaticResource TextBody}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ShareBar}" Value="{Binding Share, Mode=OneWay}" Margin="{StaticResource GapBottom4}" />
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextCaption}" Text="{Binding ShareText}" />
                                                <TextBlock Style="{StaticResource TextCaption}">
                                                    <Run Text="{Binding DetectionsText, Mode=OneWay}" /> detections, <Run Text="{Binding BansText, Mode=OneWay}" /> bans
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Tables -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left" Margin="10,8,0,6">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Table" Content="Ban history"
                                             IsChecked="{Binding ShowHistory, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Table" Content="Top offenders"
                                             IsChecked="{Binding ShowHistory, Mode=TwoWay, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding History}" AutomationProperties.Name="Ban history"
                                  Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="TimeUtc" Width="150" ElementStyle="{StaticResource CellMuted}" />
                                <DataGridTemplateColumn Header="Action" SortMemberPath="Action" Width="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource Chip}" ui:Ui.Tone="{Binding Tone}" Content="{Binding Action}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Address" Binding="{Binding IpAddress}" Width="2*" MinWidth="170" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="Engine" Binding="{Binding SourceText}" Width="100" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Offense" Binding="{Binding OffenseCount}" Width="74" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" SortMemberPath="DurationTicks" Width="96" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" MinWidth="80" ElementStyle="{StaticResource CellMuted}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding TopOffenders}" AutomationProperties.Name="Top offenders"
                                  Visibility="{Binding ShowHistory, Converter={StaticResource InverseBoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding IpAddress}" Width="2*" ElementStyle="{StaticResource CellMono}" />
                                <DataGridTextColumn Header="Bans" Binding="{Binding BanCount}" Width="90" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Worst offense" Binding="{Binding MaxOffense}" Width="120" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText}" SortMemberPath="LastSeenUtc" Width="*" ElementStyle="{StaticResource CellMuted}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </ui:StateHost>
    </Grid>
</UserControl>
