<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="WinGuard.Gui.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- The WinGuard GUI is an administrative console (like wf.msc): the service pipe
             only accepts Administrators + LocalSystem (PLAN §8), so the GUI must run with a
             full admin token. Standard users get a UAC credential prompt at launch.
             DPI: WPF is per-monitor-V2 aware natively; no manifest dpi settings needed. -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
